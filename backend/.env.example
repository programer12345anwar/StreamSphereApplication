# Local Docker Compose dependencies
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=stream_sphere_application_db
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# Central service database
DB_URL=jdbc:postgresql://localhost:5432/stream_sphere_application_db
DB_USERNAME=postgres
DB_PASSWORD=password
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT=2000ms

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE_NAME=notification-exchange
RABBITMQ_QUEUE_NAME=notification-queue
RABBITMQ_ROUTING_KEY=notification-123
RABBITMQ_RETRY_ENABLED=true
RABBITMQ_RETRY_INITIAL_INTERVAL=1000
RABBITMQ_RETRY_MULTIPLIER=2.0
RABBITMQ_RETRY_MAX_ATTEMPTS=3
RABBITMQ_REQUEUE_REJECTED=false

# Video uploads (ImageKit credentials are required to upload videos)
IMAGE_URL=https://ik.imagekit.io/replace-with-your-imagekit-id
IMAGE_PRIVATE_KEY=
IMAGE_PUBLIC_KEY=
MAX_UPLOAD_FILE_SIZE=500MB
MAX_UPLOAD_REQUEST_SIZE=500MB

# Email (SMTP credentials are required to send email)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000
MANAGEMENT_HEALTH_MAIL_ENABLED=false

# Notification branding
PLATFORM_NAME=StreamSphere
PLATFORM_BASE_URL=http://localhost:5173
PLATFORM_LOGO_URL=http://localhost:5173/logo.png

# Microservice URLs; keep PORT/SERVER_PORT unset so each service uses its own port
CENTRAL_SERVICE_URL=http://localhost:8084
VIDEO_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8082
CENTRAL_API_URL=http://localhost:8084/api/v1/central

# Security (replace with a unique, random secret for your environment)
CENTRAL_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# CORS
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:8080,http://localhost:8082,http://localhost:8083,http://localhost:8084,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176,http://127.0.0.1:5177,http://127.0.0.1:8080,http://127.0.0.1:8082,http://127.0.0.1:8083,http://127.0.0.1:8084,http://[::1]:5173,http://[::1]:5174,http://[::1]:5175,http://[::1]:5176,http://[::1]:5177

# API docs and Actuator
SWAGGER_UI_PATH=/swagger-ui.html
API_DOCS_PATH=/v3/api-docs
CENTRAL_SWAGGER_DOCS_URL=http://localhost:8084/v3/api-docs
VIDEO_SWAGGER_DOCS_URL=http://localhost:8083/v3/api-docs
NOTIFICATION_SWAGGER_DOCS_URL=http://localhost:8082/v3/api-docs
APP_DOCS_EXTERNAL_URL=https://docs.streamsphere.com
MANAGEMENT_ENDPOINTS_EXPOSE=health,info,gateway

# Gateway tuning
GATEWAY_CONNECT_TIMEOUT_MS=10000
GATEWAY_RESPONSE_TIMEOUT=30s
GATEWAY_LOG_LEVEL=INFO
