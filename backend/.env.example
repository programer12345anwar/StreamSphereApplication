# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/stream_sphere_application_db
DB_USERNAME=postgres
DB_PASSWORD=change_me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Services
CENTRAL_SERVICE_URL=http://localhost:8084
VIDEO_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8082
CENTRAL_API_URL=http://localhost:8084/api/v1/central

# Security
CENTRAL_SECRET_KEY=change_me_to_a_long_random_secret

# CORS
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080,http://localhost:8082,http://localhost:8083,http://localhost:8084,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:8080,http://127.0.0.1:8082,http://127.0.0.1:8083,http://127.0.0.1:8084
